{
  "id": "encounter-system",
  "title": "Encounter System",
  "description": "A self-contained fantasy travel and settlement encounter generator with editable RollTables and a scene toolbar button.",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Mertrum"
    }
  ],
  "url": "https://github.com/Mertrum/encounter-system",
  "manifest": "https://raw.githubusercontent.com/Mertrum/encounter-system/main/module.json",
  "download": "https://github.com/Mertrum/encounter-system/releases/download/v1.0.0/encounter-system-1.0.0.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/wfrp4e-encounter.js"
  ],
  "packs": [
    {
      "name": "encounter-tables",
      "label": "Encounter Tables",
      "type": "RollTable",
      "path": "packs/encounter-tables.db"
    },
    {
      "name": "encounter-macros",
      "label": "Encounter Macros",
      "type": "Macro",
      "path": "packs/encounter-macros.db"
    }
  ]
}
