:null},{"type":"text","weight":1,"range":[84,84],"_id":"PFpWlawvCoNW6iSh","name":"Fresh Wreckage Floating By (Small, Hostile, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[85,85],"_id":"5egyNy8l7En88mfl","name":"Wrecked Boat with 1 Survivor (Medium, Indifferent, Normal)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[86,86],"_id":"5nsowCgLeLzj0OWs","name":"Abandoned Boat Drifting Downstream (Medium, Indifferent, Normal)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[87,87],"_id":"C5ya4mGIfFwVOv7h","name":"Drunken Boatmen Fighting (Medium, Indifferent, Normal)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[88,88],"_id":"ikSsk5OnKLtbbL8W","name":"Screaming Herd Across Water (Medium, Indifferent, Obvious)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[89,89],"_id":"dggWWQLnOrFiIHyH","name":"Strange Footprints Along Shoreline (Small, Indifferent, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[90,90],"_id":"fAjXCuT5oYNgQ4uI","name":"Hooded Figure Waiting on Riverbank (Small, Indifferent, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[91,91],"_id":"Ku8He96x4Mu5Ahq0","name":"Lone Wolf Scanning River (Small, Hostile, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[92,92],"_id":"GuFtg8JmlEAiqv3W","name":"Pack Of Wolves (4) Hunting (Medium, Hostile, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[93,93],"_id":"jQRgioaGpYJI7fAq","name":"Hungry Ancient Giant Wolf (Small, Hostile, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[94,94],"_id":"8sEcwjReqZ0J6tFW","name":"Pack of Giant Wolves (6) (Medium, Hostile, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[95,95],"_id":"P7zGGIRfgajrjzN1","name":"Restless Dead Procession On River Bank (Large, Hostile, Obvious)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[96,96],"_id":"r2B9V8ONBrdgVN7a","name":"Lesser Daemonic Manifestation (Medium, Hostile, Normal)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[97,97],"_id":"Br9hWezkLw4nitT5","name":"Ghostly Choir Across The Water (Large, Hostile, Obvious)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[98,98],"_id":"uZolJMx3Fbq41mow","name":"Legendary River Threat (Large, Hostile, Obvious)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[99,99],"_id":"nyqi36Bn4MRlxwvF","name":"Wolfpack (10) With Giant Wolf Champion (Medium, Hostile, Stealthy)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[100,100],"_id":"8JnQeXBc4Kgl21qQ","name":"Cranos Lord of the river (Elemental (Large, Indifferent, Normal)","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null}],"replacement":true,"displayRoll":true,"sort":0,"ownership":{"default":0,"hA3srlFoDba8ZYIJ":3},"formula":"1d100"}
{"name":"Stay Small (Coaching inn/Farm)","_id":"pluynvJongsv2OsF","img":"icons/svg/d20-black.svg","description":"Small settlement night encounters for a coaching inn, farmhouse, roadside lodge, or other single occupied building.","results":[{"type":"text","weight":1,"range":[1,1],"_id":"RJzES5frSJ4SGR8M","name":"The owner demands payment before allowing the party through the gate, claiming travellers have recently left without paying.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[2,2],"_id":"WnxcFPAJv5MSVjlh","name":"A nervous stablehand warns that one of the animals has been found facing the same patch of darkness every night.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[3,3],"_id":"URBcXYPGQtQ5mUln","name":"The owner offers the last available beds, but says one random bedroom must remain locked.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[4,4],"_id":"nx136mUAmOdVlcee","name":"Fresh blood stains the gatepost. The occupants insist it came from an injured animal.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[5,5],"_id":"uRdxseRJbEI4VhIE","name":"A soaked traveller begs to be admitted, while the owner refuses to let them inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[6,6],"_id":"lK4HGlxCglM85cq4","name":"A guest accuses another guest of stealing a purse during the evening meal.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[7,7],"_id":"xb2JWAAAtjphDqVJ","name":"A frightened horse breaks loose and charges through the yard. Something sharp is lodged beneath its saddle.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[8,8],"_id":"SNJs7VYbAFQzCkUl","name":"The resident dog growls at an apparently empty section of the yard and refuses to approach it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[9,9],"_id":"cEP4KMV0KdDDGeaa","name":"A crude symbol has been carved into the gate. The owner immediately tries to remove it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[10,10],"_id":"7c2C4GJGqvOYXHi7","name":"A battered coach arrives without a driver. Its lamps are still burning and something moves inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[11,11],"_id":"FSIGHFyrfFDflrlk","name":"A locked room produces muffled voices after midnight, although the owner insists it is unused.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[12,12],"_id":"A0bpZFgONkHwdqDU","name":"A guest gives an obviously false name and spends the evening watching the party.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[13,13],"_id":"7xE7eJ1zazmD4t41","name":"A stablehand has been badly bitten while checking the animals and claims the attacker had a man’s hands but an animal’s face.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[14,14],"_id":"MTLrUl3Ffx8FMaeu","name":"Every animal falls silent at once. Something heavy then crosses the roof.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[15,15],"_id":"t6yIvUsUpEUVQnWe","name":"A child appears at the gate claiming to be lost. None of the occupants recognise them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[16,16],"_id":"NJeGdOtkkgQ5Mzin","name":"One stall or storage area is locked from the outside. Something within breathes heavily.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[17,17],"_id":"GXsTRHPmp05cr7d1","name":"The main door is found open during the night. Muddy footprints lead towards a random bedroom.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[18,18],"_id":"o0aHikKxhBatYln8","name":"Random Bedroom — Scratching: Scratching begins inside the wall. The owner blames rats, but the sound stops whenever anyone speaks.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[19,19],"_id":"6iL3ey1bAqEXKOs6","name":"Random Bedroom — Cold Bed: A random bedroom is unnaturally cold. The bedclothes look as though someone has recently slept there.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[20,20],"_id":"yuXSQ2CkJhjvELEe","name":"Random Bedroom — Bloody Pillow: A pillow in a random bedroom is stained with fresh blood, although nobody admits to being injured.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[21,21],"_id":"O5nFW1n4t11sdOG5","name":"Random Bedroom — Missing Guest: A guest disappears from a random bedroom. Their boots remain neatly beside the bed.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[22,22],"_id":"c9sT6jU498GeGBKF","name":"Random Bedroom — Whispering Mattress: Faint whispers come from beneath the mattress, apparently describing the people in the room.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[23,23],"_id":"x6v8vL00JAv2QhDF","name":"Random Bedroom — Locked Door: A random bedroom locks itself from the inside. There is no key in the room.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[24,24],"_id":"qYhoppqE2tUTtqoB","name":"Random Bedroom — Wrong View: Looking from a random bedroom window reveals a landscape that does not match the building’s surroundings.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[25,25],"_id":"HH0ABb2PBhPmku4r","name":"Random Bedroom — Sleeping Intruder: Someone is found asleep on the floor of a random bedroom. They claim the room belongs to them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[26,26],"_id":"2xJbLzS50KVcigQm","name":"Random Bedroom — Moving Chest: A chest in a random bedroom has moved during the night. It contains only blankets and one fresh muddy footprint.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[27,27],"_id":"6ZosBDjDqHXUEWC8","name":"Random Bedroom — Rats at the Door: Rats gather outside a random bedroom and refuse to disperse. Something inside seems to be calling them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[28,28],"_id":"nAU88AzTLVCjBdye","name":"Random Bedroom — The Empty Seat: The bed in a random bedroom creaks as though someone has sat down upon it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[29,29],"_id":"kwGXC1zmNav0EDkB","name":"Random Bedroom — Dead Candle: A candle in a random bedroom repeatedly goes out. Each time, a different object has moved.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[30,30],"_id":"CqRavkuvarKtM5w8","name":"Random Bedroom — Shared Dream: Everyone sleeping in a random bedroom dreams of standing outside the building while something watches from the gate.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[31,31],"_id":"LYSrJ5of35feLxmY","name":"The well rope is found freshly cut. A wet handprint appears on the stone rim despite clear weather.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[32,32],"_id":"QIfFJfcD3OHfQimS","name":"The night watchman has fallen asleep at the gate and insists someone stood beside him for hours.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[33,33],"_id":"JvE0I2wCm9AN2AR4","name":"A black feather is found in a meal, a boot, and the party’s baggage. The owner becomes visibly frightened.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[34,34],"_id":"IREhUi0puKPKki3o","name":"A pedlar arrives demanding payment for goods the owner claims were never delivered.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[35,35],"_id":"K3V1ttXpVLAm2tVE","name":"The bell above the gate rings repeatedly during the night, although nobody is near it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[36,36],"_id":"Nj9gDxXEFn5iGm2T","name":"A loose floorboard beneath a table conceals letters describing a planned robbery.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[37,37],"_id":"XNMa4gHgFbO2d21t","name":"A mule refuses to enter the stable and keeps staring towards one random bedroom window.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[38,38],"_id":"wubszq5Hx2YWihcC","name":"A half-burned letter in the fireplace mentions the party’s arrival before they reached the building.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[39,39],"_id":"DiqzdbqFveWYljpB","name":"The storage area or barn is locked, but something inside drags tools across the floor.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[40,40],"_id":"FFqnIJtjRpNTkQvu","name":"The owner offers cheaper accommodation if the party agrees to carry a sealed parcel onwards.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[41,41],"_id":"MqbHEHw7HuIboy0d","name":"A hooded stranger asks whether the party has already arrived, then leaves immediately after hearing the answer.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[42,42],"_id":"xXNqOG31ZtNcFjBt","name":"Someone shouts that Beastmen are attacking the gate. The alarm is false—but the gate has been opened.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[43,43],"_id":"9X6qRzN1QyNacPWl","name":"An occupant arrives from outside after midnight asking for help finding someone who is supposedly asleep upstairs.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[44,44],"_id":"i7nO8jXKkJqW7j8e","name":"The evening meal contains meat nobody can identify. The owner becomes defensive when questioned.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[45,45],"_id":"UGWjbKXixL7GLvwh","name":"A lantern disappears from the entrance and is later found burning in a nearby field.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[46,46],"_id":"pXTwU5bzbmpOsUt6","name":"Deep scratches cover the outside of a random bedroom’s shutters. They are too high to have been made by an ordinary animal.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[47,47],"_id":"VVI0pZO79nNpD7po","name":"A voice calls a character’s name from the yard, using the voice of someone they trust.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[48,48],"_id":"iwpfITGH0REUId6J","name":"Fresh hoofprints circle the building three times before ending beneath a random bedroom window.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[49,49],"_id":"PVF5bqnz9hcNXuuw","name":"Everyone sleeping in the building dreams of the same old woman standing beside the gate. In the morning, muddy footprints lead to the owner’s room.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[50,50],"_id":"VkkFEmzQ0DN23H1V","name":"A deep thump shakes the building during the night. The owner blames the structure settling, but the sound comes again from beneath a random bedroom.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[51,51],"_id":"DYjaTkCnhxRXI5I3","name":"A group of armed robbers watches the building from the roadside, waiting for the occupants to sleep.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[52,52],"_id":"6Gq0kHRPJjlCAU7P","name":"A wounded roadwarden arrives at the gate claiming Beastmen attacked him. His pursuers reach the building minutes later.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[53,53],"_id":"Dja88CsnooQUrXCb","name":"A pack of hungry wolves circles the building. They are unusually bold and test the doors during the night.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[54,54],"_id":"5AIj9QkP2LiBxDJD","name":"A mutant hides among the guests. Strange noises come from a random bedroom after everyone has gone to sleep.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[55,55],"_id":"vXTujOGSHJ4YARrq","name":"A small band of Beastmen has followed the party and begins testing the gate, shutters, and stable doors.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[56,56],"_id":"6mhzcXAQEMEbFaOB","name":"A ghoul is seen crouching near the refuse pit. By morning, a dead animal has been dragged beneath the building.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[57,57],"_id":"jTQRjMIRE8CImnkQ","name":"Skaven tunnel beneath the building during the night. A random bedroom floor collapses into a foul-smelling passage.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[58,58],"_id":"AVqCSnPgo3at4WGJ","name":"A desperate fugitive begs for shelter, followed by bounty hunters who are willing to force their way inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[59,59],"_id":"Cku3THpI0lSNwCgF","name":"A pack of man-eating dogs attacks the yard. The animals behave as though someone trained them to target the occupants.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[60,60],"_id":"VLt5T8I8QQ8AfuwB","name":"A group of masked cultists surrounds the building and demands that one particular guest be handed over.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[61,61],"_id":"hl1bzdbR8llzDOq5","name":"A corpse disappears from a wagon or burial cart outside. Scratching is heard beneath a random bedroom floor.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[62,62],"_id":"E4ExN6d8E5ZPNHwd","name":"A large spider has entered the rafters. Webbing blocks the chimney, and someone sleeping in a random bedroom is bitten.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[63,63],"_id":"KBiEgTqOzHieatmt","name":"A hunched figure is seen crossing the roof. It is searching for a way into a random bedroom.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[64,64],"_id":"XWdPpcugRaKUk8i4","name":"Two highwaymen attempt to rob the building, but one is secretly a mutated killer who turns on the others.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[65,65],"_id":"Rf2pKpAPFudMBdwH","name":"A strange bird attacks anyone approaching the gate. Its feathers are coated with a substance that causes sickness.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[66,66],"_id":"gHOWuY24ek0yWOHU","name":"A mob arrives accusing one of the occupants of murder. The accusation is false, but someone inside is preparing an attack.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[67,67],"_id":"HMgCuaGC8oVsyG2u","name":"A lone Beastman is found hiding beneath a cart. It claims to be fleeing a larger warband approaching from the road.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[68,68],"_id":"Pkm2NhXbCyusVCz6","name":"A vampire’s servant arrives after sunset asking for a room. During the night, a random bedroom is found unlocked and empty.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[69,69],"_id":"uqbUUfmuFieLcOKG","name":"A swarm of unusually large rats pours from the drains and attacks food stores, animals, and anyone who tries to drive them away.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[70,70],"_id":"WsNSUlrjlFTLlfvX","name":"Something pounds on the gate after midnight. When the occupants open it, nobody is outside—but bloody footprints lead towards a random bedroom.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[71,71],"_id":"At8Ch1PFx1Wninzz","name":"You hear a local rumour: a farmer nearby has been paying unusually high wages to anyone willing to work after dark.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[72,72],"_id":"38UYlVivzl9PvIwM","name":"You hear a local rumour: a traveller who stayed here recently left before dawn and was never seen again on the road.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[73,73],"_id":"uoc7sVc3ZfZ9yWFs","name":"You hear about a trade opportunity: the local owner has surplus grain and livestock products available for a reliable buyer.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[74,74],"_id":"YdMMl0dmdRM98V5d","name":"You hear about a trade opportunity: a passing merchant is looking for someone to carry local produce to the next settlement.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null}],"replacement":true,"displayRoll":true,"sort":0,"ownership":{"default":0,"hA3srlFoDba8ZYIJ":3},"formula":"1d74"}
{"name":"Stay medium (Small Medium Settlement)","_id":"uQlnrqSAutFpLGnu","img":"icons/svg/d20-black.svg","description":"Village and hamlet night encounters for a small or medium settlement with several buildings and communal locations.","results":[{"type":"text","weight":1,"range":[1,1],"_id":"MngucXlVIQROMFC3","name":"The gatekeeper asks where the party is travelling from and quietly warns that strangers have recently been watched from the rooftops.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[2,2],"_id":"Kqup4SB67yvfOeV6","name":"The local reeve insists on recording the party’s names, occupations, and reason for staying.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[3,3],"_id":"57fPwg80VETyC06n","name":"Every lodging house claims to be full. The party is eventually offered floor space in a communal hall.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[4,4],"_id":"dUueCGncOzvn4ftK","name":"Two groups of villagers argue over whether the party should stay. One side welcomes them; the other demands they leave before dark.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[5,5],"_id":"uDs07yOhMaQxsTYw","name":"The settlement bell has disappeared from its tower. The villagers fear it was stolen as a warning of danger.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[6,6],"_id":"gtNAQgBtOCFcsYaH","name":"Locals claim someone matching one of the party’s descriptions was seen here several days ago.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[7,7],"_id":"ESA1kHzFj2FeEClW","name":"The village shrine is locked before sunset, and the priest refuses to explain why.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[8,8],"_id":"6pgF9a9aOd4HgzGX","name":"The common room is packed with villagers discussing a recent disappearance in the surrounding fields.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[9,9],"_id":"RgXthrnBMSw04p53","name":"The lodging house owner says another guest has been sleeping in the stable rather than using their room.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[10,10],"_id":"EDLuK0r7QVRsxbqR","name":"The party is asked to join the night watch because several local families have refused to patrol the outskirts.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[11,11],"_id":"0Jn3KtYDLWQSFN6N","name":"A farmer failed to return from a nearby field. The family asks whether the party will help search.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[12,12],"_id":"OMtOS1m6T6Dygy7f","name":"The settlement granary is heavily secured despite there being no visible shortage of food.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[13,13],"_id":"pK9kibC3xE8ekN7V","name":"The reeve demands an unexpected night levy from every traveller staying in the settlement.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[14,14],"_id":"nHGURMfGwnpC2uis","name":"The local smith says several weapons were repaired recently, but refuses to say who brought them in.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[15,15],"_id":"nEjStG7Tl1diGcF5","name":"A cottage stands prepared for visitors, but its former occupants vanished without taking their belongings.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[16,16],"_id":"72p5jHLvPSRoo51y","name":"The villagers invite the party to a communal meal. One seat is deliberately left empty.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[17,17],"_id":"8FXbHCHCSN4uCqUV","name":"A child asks the party to help find a missing sibling. The adults insist the sibling never existed.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[18,18],"_id":"Q4xTs2uuqkZRxAdr","name":"The local priest refuses to speak after sunset and communicates only by writing short warnings.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[19,19],"_id":"GkepG96VxvmDD39y","name":"A party horse disappears from the village stable. It is found at the far end of the settlement facing the fields.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[20,20],"_id":"fX4vKocyqbmP43SD","name":"A musician sings a song about the party’s arrival before anyone has introduced them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[21,21],"_id":"FouRP8xOYgIy4Fdu","name":"Random Bedroom — Footsteps: Footsteps pass repeatedly outside a random bedroom, but nobody is seen in the corridor or passage.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[22,22],"_id":"9ktttMnbjNhQpPv0","name":"Random Bedroom — Someone Looking In: A face is briefly seen at the window of a random bedroom. The ground outside shows no footprints.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[23,23],"_id":"nOiHm9TwsoDo5ezF","name":"Random Bedroom — The Wrong Room: A sleeping character wakes in a random bedroom that is not the room they went to bed in.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[24,24],"_id":"CF4Zh77VWboIpFOU","name":"Random Bedroom — Hidden Guest: Someone is hiding beneath the bed in a random bedroom. They claim to be avoiding a local official.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[25,25],"_id":"OaT1dUIbxV9X40gI","name":"Random Bedroom — Scratched Name: A character’s name has been scratched into the door of a random bedroom during the night.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[26,26],"_id":"pzdAbc7lXquBSFk1","name":"Random Bedroom — Empty Bed: A random bedroom contains one more bed than the owner remembers. It is still warm.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[27,27],"_id":"jew7kt4bZHNvAfcc","name":"Random Bedroom — Night Visitor: A guest in a random bedroom hears someone quietly asking to be let inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[28,28],"_id":"PRa4DQR9SYsxXql4","name":"Random Bedroom — Moving Latch: The door latch of a random bedroom lifts and drops repeatedly while everyone inside is awake.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[29,29],"_id":"dFrvwtcYcDYRoznq","name":"Random Bedroom — Wet Footprints: Wet footprints lead from the window of a random bedroom to the bed.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[30,30],"_id":"UEenfAhbuGxAFFIj","name":"Random Bedroom — Shared Dream: Everyone sleeping in a random bedroom dreams of the settlement’s buildings standing empty and burning.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[31,31],"_id":"ixA5m39a5lonBRYM","name":"The settlement watchman raises the alarm after seeing movement near the outer houses.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[32,32],"_id":"37AySbYadLrYk6NK","name":"Two groups of travellers claim they have been assigned the same room and both possess a key.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[33,33],"_id":"BXsfdlYCKdV3QN1V","name":"The party arrives during a heated dispute over who should replace the dead village head.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[34,34],"_id":"5xsItLoYz6GoIrH9","name":"A broken cart blocks the main street. Its cargo includes something the owner desperately wants kept hidden.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[35,35],"_id":"Hj5Dh33j1vq6ZMgy","name":"A stranger has been sleeping beside the shrine and claims to receive messages from the dead.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[36,36],"_id":"48eh2voDA0tOaL5R","name":"A village stable contains saddles, harnesses, and feed, but no animals.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[37,37],"_id":"s3B9iZvfT0i9GP8r","name":"The owner of the lodging house asks the party to guard a storehouse until morning.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[38,38],"_id":"KmEtrAdYJMB0Enpt","name":"Several street lanterns have been removed, leaving one particular lane in darkness.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[39,39],"_id":"GbvfHT8fsUd7BZOe","name":"The smithy is shut during the evening, but hammering continues inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[40,40],"_id":"2CaSn5VqhIwLHSFt","name":"Two families accuse one another of stealing grain. Both ask the party to confirm their story.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[41,41],"_id":"knTsEbneEbH5Sh8m","name":"Every villager knows the party has arrived, but nobody admits to telling them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[42,42],"_id":"7zAlZkwY27EWLda9","name":"The village watchtower is found abandoned just as night approaches.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[43,43],"_id":"lKoEYG2RuMkXV7h1","name":"Several village dogs gather outside the party’s lodging and bark towards the road.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[44,44],"_id":"E1aXunJFJ5aGXtHD","name":"A locked trunk is left in the common room. Nobody will admit who brought it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[45,45],"_id":"GSZNe12PfJc1YidN","name":"The village shrine has been vandalised, but the damage appears to have been done from inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[46,46],"_id":"FTZta02mVSJzT4lH","name":"Villagers walk silently through the settlement carrying covered lanterns. They refuse to explain the ceremony.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[47,47],"_id":"1ke5NwzebzwHC5Xr","name":"The reeve orders every door barred before sunset and sends watchmen through the streets.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[48,48],"_id":"yMtLl5fXQCteZJZ2","name":"The owner sets a place for someone who never arrives. Nobody will sit in that chair.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[49,49],"_id":"nZcqxCRRMCUeNKM2","name":"Villagers warn the party not to draw water from the old well after dark.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[50,50],"_id":"9EmIdLpbhgukcd1w","name":"A dying traveller leaves a message naming the settlement, then dies before explaining what danger is coming.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[51,51],"_id":"0UYzsv1pmonovWNK","name":"The settlement watch challenges the party at the gate with drawn weapons, claiming a murderer is hiding among them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[52,52],"_id":"YKLPtinWHJ1DWXqJ","name":"A crowd gathers outside the party’s accommodation demanding that a particular guest be handed over.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[53,53],"_id":"qD2YUz1BhSmubWQC","name":"Strange figures are seen beyond the fields. The villagers believe they are scouts for a larger Beastman warband.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[54,54],"_id":"EBXB5cCVmswu1bbx","name":"A mutant hides among the guests. Someone has recognised them and intends to expose them before morning.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[55,55],"_id":"o4cGtYzlZfKuZ92X","name":"A ghoul is seen near the graveyard. By morning, a corpse has disappeared and scratching comes from beneath a random bedroom floor.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[56,56],"_id":"JuixB9OXs2TJvn2b","name":"A tunnel opens beneath a random bedroom or lodging house. It smells of filth, fungus, and old blood.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[57,57],"_id":"ZD4hnlbaDIPDqcCl","name":"Armed robbers attack the settlement’s outer buildings while most residents are asleep.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[58,58],"_id":"il7resIut9fphOGx","name":"A villager accuses the party of witchcraft. The accusation is being encouraged by someone who wants the settlement distracted.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[59,59],"_id":"xJuHviV1MMQiFkqq","name":"Masked villagers gather outside the gate and demand that the settlement’s priest open the shrine.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[60,60],"_id":"GecSE24qe4QHFkcR","name":"Several local children have vanished. A trail leads towards a locked building on the edge of the settlement.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[61,61],"_id":"drJnHWRNDFWnfhCG","name":"A dark coach arrives after sunset and requests accommodation for one passenger. The driver refuses to show their face.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[62,62],"_id":"BoLR2r3NAKlBGVaT","name":"Wolves attack livestock near the settlement. Their tracks suggest they have been driven towards the village deliberately.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[63,63],"_id":"DBPz6xIVKb6lzmDr","name":"Scratches and greasy pawprints are discovered beneath the floorboards of the lodging house.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[64,64],"_id":"icZLZy29tWbA6h2J","name":"A wounded fugitive begs for sanctuary, followed by armed pursuers who claim the fugitive is a murderer.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[65,65],"_id":"FpT6JexB2RgjREDf","name":"A shed or barn catches fire during the night. Someone has locked the occupants inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[66,66],"_id":"uB6f0Ixomb0vI9Ky","name":"Figures are seen leaving the graveyard carrying a body. The village watch is too frightened to intervene.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[67,67],"_id":"gZXJ2ixj4w8JfBN9","name":"Something attacks the miller and disappears into the mill. The villagers ask the party to help search it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[68,68],"_id":"QDgFyUtL4f02sLgl","name":"A local resident begins speaking in a voice that is not their own and names people who will die before dawn.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[69,69],"_id":"olxNGuxiJt2vj4YG","name":"Someone tries to force entry into a random bedroom during the night. The attacker flees before their identity is discovered.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[70,70],"_id":"iIMsbEaYFqYx5wZ6","name":"A horn sounds outside the settlement. Several groups approach from different directions, and the villagers cannot tell whether they are rescuers, raiders, or something worse.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[71,71],"_id":"Y4JTp9wfhjdfPqaA","name":"Ogre at the Gate: An injured Ogre arrives demanding food and shelter. It becomes violent when the occupants refuse.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[72,72],"_id":"cAJjEkxc749VwI1G","name":"Troll Beneath the Bridge: A Troll attacks the settlement’s bridge, blocking escape and threatening anyone who approaches.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[73,73],"_id":"AX3udECTcXnOPxHK","name":"Rat Ogre in the Storehouse: A Rat Ogre smashes into the settlement storehouse while smaller Skaven raid nearby buildings.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[74,74],"_id":"EOhIx5cwMrK8LdZ8","name":"Ghoul Pack at the Graveyard: Several Ghouls emerge from the graveyard and begin moving towards the settlement. Their presence is discovered when a random bedroom occupant hears scratching beneath the floor.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[75,75],"_id":"6xgGHHq2zOrWT6FT","name":"Chaos Spawn in the Village: A grotesquely mutated creature crashes through a wall or gate, attacking anything that moves before disappearing into the darkness.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[76,76],"_id":"WpKiSu5FAVz1jpIX","name":"You hear a local rumour: a nearby household has discovered a hidden store of goods bearing the mark of a powerful merchant guild.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[77,77],"_id":"56lGJL2xYAigqL2Q","name":"You hear a local rumour: several local traders have quietly stopped using one road because something is taking goods from the wagons.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[78,78],"_id":"7vRvAqD7Lu7gIawS","name":"You hear about a trade opportunity: a local trader needs buyers for a shipment of grain, wool, timber, or livestock.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[79,79],"_id":"Gm9WYsMDuAulTTHG","name":"You hear of two trade opportunities: one trader offers local produce at a good price, while another seeks buyers for imported goods.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null}],"replacement":true,"displayRoll":true,"sort":0,"ownership":{"default":0,"hA3srlFoDba8ZYIJ":3},"formula":"1d79"}
{"name":"Stay Large (Town/Small city)","_id":"WROYaycWtNP6KTFT","img":"icons/svg/d20-black.svg","description":"Town and small-city night encounters involving gates, streets, accommodation, districts, the city watch, and urban dangers.","results":[{"type":"text","weight":1,"range":[1,1],"_id":"ZMjiJftYWA6UkQIq","name":"The gate clerk records the party’s names, occupations, possessions, and intended lodging.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[2,2],"_id":"jFzJHpIcpw9Q2ZV0","name":"A long line of travellers waits outside the gate while guards search every wagon entering the town.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[3,3],"_id":"CLtQf1HtDP4mCoVL","name":"The gate guard claims the party has not paid the correct entry fee and threatens to delay them until the matter is settled.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[4,4],"_id":"T4b6HsqHZyjjGpPV","name":"A local offers to guide the party to accommodation, but several other guides begin competing for their business.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[5,5],"_id":"3bEJxoKrZA6oU5UN","name":"The shortest route to the inns is blocked by guards. Nobody will explain what happened in the district beyond.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[6,6],"_id":"2KVHzl42SOeKD3av","name":"The party is stopped by watchmen investigating a recent series of robberies.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[7,7],"_id":"quLOOaKHd3sROK0z","name":"Every respectable inn is full. The party is directed towards a cheaper establishment in a less reputable district.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[8,8],"_id":"lhubE8DrL5ebfyJe","name":"Two groups of travellers claim to have been assigned the same room and both possess a legitimate key.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[9,9],"_id":"pmvUc14AkQO3AtrB","name":"An innkeeper offers rooms at an unusually low price, provided the party does not complain about noises from upstairs.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[10,10],"_id":"lhyugJK0Wvu3DPqX","name":"A noble procession blocks the street while the party is trying to reach accommodation.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[11,11],"_id":"4ASsLMbhDUASWUIA","name":"The party arrives as the market is being cleared. A trader begs them to hide a sealed parcel before the watch returns.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[12,12],"_id":"Vo3L3sut23cySuC1","name":"A fight breaks out between dockworkers, apprentices, or mercenaries. One combatant attempts to hide among the party.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[13,13],"_id":"BN5a4CfhRdMt7MZ1","name":"A child asks the party to help find their family, but several adults nearby insist the child belongs to them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[14,14],"_id":"KiUBUs7wA7AfFI4s","name":"A character discovers that their purse is missing. A young pickpocket is caught nearby holding something belonging to another traveller.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[15,15],"_id":"0teRDyl9yUQqkf0O","name":"A respectable citizen directs the party to a lodging house that does not exist, then disappears into the crowd.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[16,16],"_id":"Z33HDVtgcrbpZ5fd","name":"Guests claim someone matching one of the party’s descriptions has been asking questions about them.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[17,17],"_id":"GIrlWDJ2rnHqZCVU","name":"Temple bells ring unexpectedly during the night. Residents say the bells only sound when the city is under threat.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[18,18],"_id":"AbqMIzK8C8Evv9ZY","name":"A boarding house has lights burning inside, but nobody answers the door.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[19,19],"_id":"xDTJUECACpfk3j5F","name":"The city watch announces an immediate curfew, ordering everyone indoors before the next bell.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[20,20],"_id":"3CjyGUQJ3eCOORX3","name":"The innkeeper assigns the party a room beside a guest who never speaks, eats, or appears to sleep.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[21,21],"_id":"OZsXYKztaZhHPL1F","name":"Random Bedroom — Scratching: Scratching begins inside the wall of a random bedroom. The sound moves from room to room.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[22,22],"_id":"sPtq5gDPx9DUpm5t","name":"Random Bedroom — Someone at the Window: A face is seen at the window of a random bedroom several floors above street level.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[23,23],"_id":"vXjkQmtb0lmea6vc","name":"Random Bedroom — Wrong Room: A sleeping character wakes in a random bedroom belonging to another guest.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[24,24],"_id":"KhjUwkpOCNQRQOAt","name":"Random Bedroom — Hidden Compartment: A loose panel in a random bedroom conceals letters concerning a murder or political conspiracy.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[25,25],"_id":"VApGIOVSnFWj5eLa","name":"Random Bedroom — Secret Visitor: Someone enters a random bedroom during the night and leaves behind a sealed letter.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[26,26],"_id":"yvfK23Q10MIbhNOg","name":"Random Bedroom — Missing Guest: A guest disappears from a random bedroom. Their clothing and possessions remain behind.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[27,27],"_id":"kUEim2AYtze5Kn7a","name":"Random Bedroom — Blood on the Door: Fresh blood is smeared across the door of a random bedroom, but nobody inside is injured.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[28,28],"_id":"njcq2rj3VTjD1bgj","name":"Random Bedroom — Wrong View: A random bedroom window appears to overlook a different part of the city than it should.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[29,29],"_id":"w14xYQ2xH1cyhunl","name":"Random Bedroom — Hidden Tenant: Someone is discovered hiding beneath the bed in a random bedroom. They claim to be hiding from the watch.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[30,30],"_id":"dRaDgElC522pHcg3","name":"Random Bedroom — Empty Bed: A random bedroom contains one more bed than the room should hold. It is warm and recently slept in.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[31,31],"_id":"sskaCa0VgqWWIkt8","name":"Two guild representatives argue over which one has the right to house the party.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[32,32],"_id":"HTL8Y8XmlneABaji","name":"A neighbour complains about noise from the party’s accommodation before anything has happened.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[33,33],"_id":"7siBLgG6NwUalBjL","name":"A performer reenacts an event from the party’s past despite having no obvious way to know about it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[34,34],"_id":"CPGAJfTTRDRrhncr","name":"The sign outside the party’s lodging has been damaged, and someone has painted a warning beneath it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[35,35],"_id":"M0V07gR5KrB1ZBtj","name":"A local challenges one of the characters to a drinking contest, arm-wrestling match, or public wager.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[36,36],"_id":"I8RrlMNkbCWh34pp","name":"The accommodation owner asks the party to help locate a servant who vanished while running an evening errand.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[37,37],"_id":"9bLou423jrGiMIiA","name":"The owner refuses access to the cellar, although noises and heavy footsteps can be heard beneath the floor.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[38,38],"_id":"T0n5C4GXHAZNVzf1","name":"A street map offered to the party contains several districts that do not appear on any official map.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[39,39],"_id":"CQeFMflXEORtX8lw","name":"A city shrine has been shut and guarded. The priest claims the closure is for routine repairs.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[40,40],"_id":"Si8UxCD8C41CO8T7","name":"Watchmen attempt to arrest one of the party for a crime committed earlier that day.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[41,41],"_id":"U2ebeROXDFiFjBVc","name":"A parcel is delivered to the party’s accommodation. It contains an item belonging to someone who died recently.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[42,42],"_id":"zK8WFsucEuxDdCXC","name":"A figure follows the party through several streets, always vanishing whenever they turn around.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[43,43],"_id":"14Cl1YJzRIorL8ky","name":"A fine carriage waits outside the accommodation with nobody inside and no driver in sight.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[44,44],"_id":"LwB0iFxXRdOXPvGD","name":"A stone is thrown through a window during the evening. A scrap of paper tied to it bears a single warning.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[45,45],"_id":"0SXiyhjViHLvWaol","name":"The key to one of the party’s rooms disappears from the owner’s key board.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[46,46],"_id":"RL8pf2pjcGZB3CD7","name":"A silent procession moves through the street carrying covered lanterns and a sealed coffin.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[47,47],"_id":"0qAz3cxOnwnSm8zm","name":"The innkeeper claims the party has inherited another guest’s unpaid debts.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[48,48],"_id":"pwXgC6F5966OwOC7","name":"Watch whistles sound in several different districts at once.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[49,49],"_id":"YA9b8tb8XaSgEnmx","name":"A normally busy alley is sealed by the city watch. Something inside has left a trail of blood.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[50,50],"_id":"sMExFQrpkTbFfPOr","name":"Everyone in the accommodation has heard a different story about why the city gates may close by morning.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[51,51],"_id":"3HW4DoatBXHPNA5U","name":"The guards search the party aggressively after claiming a dangerous criminal entered the town disguised as a traveller.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[52,52],"_id":"MhS7uoy0qxkD0Yib","name":"Armed thugs attack the party in a narrow street before fleeing into the crowd.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[53,53],"_id":"BgcAjVLNh87DXsUt","name":"A crowd gathers outside the accommodation after a rumour spreads that one of the party is a witch, mutant, or murderer.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[54,54],"_id":"fQHsGB3TWbSwsn5r","name":"Masked cultists meet in a nearby building and begin watching the party’s lodging.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[55,55],"_id":"EHfGAdnFym0ohlht","name":"A mutant is hiding among the guests. The city watch is searching the accommodation floor by floor.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[56,56],"_id":"6yb06o4wV7zSdej2","name":"The city watch bursts into the accommodation looking for stolen goods. Someone has planted contraband in a random bedroom.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[57,57],"_id":"x3kGxHJHKn12axal","name":"A crossbow bolt strikes the wall beside a character while the party is travelling between lodging and the market.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[58,58],"_id":"U0vETq8VgmGTAGfi","name":"A local criminal gang demands payment for protection before the party can remain safely in the district.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[59,59],"_id":"fuDoZ04zdVYD910i","name":"A corpse disappears from a guarded mortuary. Scratching is later heard beneath a random bedroom.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[60,60],"_id":"V4p31rAoFgP8UjAA","name":"A nearby building catches fire during the night. Someone is deliberately preventing the occupants from escaping.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[61,61],"_id":"TgQTxR4OzKI4xPga","name":"Something breaks through the sewer grating beneath the street and drags away a watchman.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[62,62],"_id":"SYZYsi4j8EyB0zXx","name":"Someone has tampered with food served at the accommodation. The owner claims the poison was meant for another guest.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[63,63],"_id":"w4IbPqXuJAQ8ZAdH","name":"Armed strangers attempt to seize one of the party’s companions in the street.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[64,64],"_id":"S8ppFsspbN05jtkm","name":"A wounded fugitive forces their way into the accommodation, followed by watchmen who insist the fugitive must be handed over immediately.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[65,65],"_id":"hINRBAb0HbytSM5q","name":"A district is sealed by the watch while armed men search every building. The party finds itself trapped inside.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[66,66],"_id":"wJonGgRpAbR8XJpd","name":"Attackers try to enter the accommodation through the roof, cellar, or rear courtyard.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[67,67],"_id":"Gtq7E98IOhurH67Z","name":"People in the district begin falling ill after drinking from a public well. Someone has been seen carrying barrels into a nearby cellar.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[68,68],"_id":"a0OkouwcYHIQQIZ5","name":"The party arrives as the watch prepares to execute a prisoner. The prisoner recognises one of the characters and shouts a warning.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[69,69],"_id":"mEi1G8KPYK78IGbw","name":"Someone tries to force entry into a random bedroom during the night. The attacker flees before their identity is discovered.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[70,70],"_id":"Fm0k2nX8hjHJumxF","name":"Bells, horns, and watch whistles announce danger throughout the town. The gates close while the party is still outside their accommodation.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[71,71],"_id":"sH6EQmsnmoxek5NZ","name":"Ogre in the Market: An enraged Ogre smashes through a market street, overturning stalls and demanding food while the watch struggles to contain it.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[72,72],"_id":"g3SCfMqequ0R8acH","name":"Troll in the Sewer: A Troll emerges from the sewers beneath the district and attacks anyone near the street drains.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[73,73],"_id":"lXAoA4Q7GCQWxCmT","name":"Rat Ogre in the Alley: A Rat Ogre bursts from a narrow alley while Skaven steal supplies from nearby cellars.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[74,74],"_id":"V9hBFb8GxpEE1u1f","name":"Ghoul Pack Beneath the City: Ghouls emerge from an old crypt or sewer passage. Scratching begins beneath a random bedroom as they search for a way into the building.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[75,75],"_id":"VpDG0k9w9omJDqeO","name":"Chaos Spawn in the District: A grotesquely mutated creature tears through a wall, street, or lodging house, attacking anyone nearby before disappearing into the city’s darkness.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[76,76],"_id":"CXwgq7JgQTe4A7WF","name":"You hear a local rumour: a merchant house is concealing the loss of a valuable shipment and is blaming innocent carriers.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[77,77],"_id":"JH2GNRlbfDC5r1M8","name":"You hear a local rumour: a wealthy trader is quietly buying up a particular commodity before its price rises across the region.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[78,78],"_id":"SofdDaI6SzdBwO7x","name":"You hear about a trade opportunity: a guild trader is seeking reliable buyers or carriers for a substantial commercial shipment.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null},{"type":"text","weight":1,"range":[79,79],"_id":"UEAgra30pWlJQzw1","name":"You hear of two trade opportunities: one concerns goods arriving through the town gates, while the other involves a shipment leaving by river or road.","img":"icons/svg/d10-grey.svg","description":"","drawn":false,"documentUuid":null}],"replacement":true,"displayRoll":true,"sort":0,"ownership":{"default":0,"hA3srlFoDba8ZYIJ":3},"formula":"1d79"}
