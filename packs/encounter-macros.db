{"name":"Encounter Generator","type":"script","img":"icons/svg/road-sign.svg","scope":"global","command":"/*\n * Encounter System - ROAD JOURNEY LEG\n *\n * Uses the existing wilderness encounter tables and optionally replaces only\n * the final night's wilderness roll with a settlement event.\n */\n\n(async () => {\n  const DISTANCE_TABLE = \"Distance Encountered\";\n  const AWARENESS_TABLE = \"Awareness\";\n  const EXTRA_ENCOUNTER_CHANCE = 5;\n\n  const SETTLEMENT_TABLES = {\n    Small: \"Stay Small (Coaching inn/Farm)\",\n    Medium: \"Stay medium (Small Medium Settlement)\",\n    Large: \"Stay Large (Town/Small city)\"\n  };\n\n  const ENCOUNTER_CHANCES = {\n    Road:      { Morning: 23, Afternoon: 23, Night: 30 },\n    River:     { Morning: 30, Afternoon: 30, Night: 40 },\n    Forest:    { Morning: 30, Afternoon: 30, Night: 40 },\n    Marsh:     { Morning: 30, Afternoon: 30, Night: 50 },\n    Hills:     { Morning: 23, Afternoon: 23, Night: 30 },\n    Mountains: { Morning: 30, Afternoon: 30, Night: 40 }\n  };\n\n  const DISTANCE_STEPS = [\n    \"Close Distance\",\n    \"Medium Distance\",\n    \"Maximum Distance\"\n  ];\n\n  const escapeHtml = value => String(value ?? \"\")\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#039;\");\n\n  const stripHtml = value => String(value ?? \"\")\n    .replace(/<[^>]*>/g, \" \")\n    .replace(/&nbsp;/gi, \" \")\n    .replace(/&amp;/gi, \"&\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n\n  const normalise = value => stripHtml(value)\n    .toLowerCase()\n    .replace(/[—–-]/g, \"-\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n\n  function getTable(name) {\n    const exact = game.tables.getName(name);\n    if (exact) return exact;\n\n    const wanted = normalise(name);\n    return game.tables.find(table => normalise(table.name) === wanted);\n  }\n\n  async function tableResultText(result) {\n    if (typeof result === \"string\" || typeof result === \"number\") {\n      return String(result);\n    }\n\n    const directText = result?.description\n      ?? result?._source?.description\n      ?? result?.data?.description\n      ?? result?.document?.description\n      ?? result?.text\n      ?? result?._source?.text\n      ?? result?.document?.text\n      ?? result?.data?.text\n      ?? result?.result\n      ?? result?._source?.result\n      ?? result?.document?.result\n      ?? result?.data?.result\n      ?? result?.name\n      ?? \"\";\n\n    if (directText && stripHtml(directText)) {\n      return directText;\n    }\n\n    if (typeof result?.getHTML === \"function\") {\n      const html = await result.getHTML();\n      if (html && stripHtml(html)) {\n        return html;\n      }\n    }\n\n    return \"\";\n  }\n\n  function firstDrawResult(draw) {\n    const results = draw?.results;\n\n    if (!results) {\n      return draw ?? null;\n    }\n\n    if (Array.isArray(results)) {\n      return results[0] ?? null;\n    }\n\n    if (typeof results.first === \"function\") {\n      return results.first();\n    }\n\n    if (typeof results.values === \"function\") {\n      return results.values().next().value ?? null;\n    }\n\n    return results[0] ?? results;\n  }\n\n  async function drawTableResult(name) {\n    const table = getTable(name);\n\n    if (!table) {\n      throw new Error(`RollTable not found: ${name}`);\n    }\n\n    for (let attempt = 0; attempt < 20; attempt++) {\n      const draw = await table.draw({\n        displayChat: false\n      });\n\n      const result = firstDrawResult(draw) ?? draw;\n      const text = await tableResultText(result);\n\n      if (!text) {\n        throw new Error(`RollTable has no usable result: ${name}`);\n      }\n\n      if (normalise(text) !== \"roll again\") {\n        return text;\n      }\n    }\n\n    throw new Error(`Too many Roll Again results in: ${name}`);\n  }\n\n  async function d100() {\n    const roll = await new Roll(\"1d100\").evaluate({\n      async: true\n    });\n\n    return roll.total;\n  }\n\n  function weatherEffects(weatherText) {\n    const weather = normalise(weatherText);\n\n    let distanceShift = 0;\n    let awarenessModifier = 0;\n    const effects = [];\n\n    if (weather.includes(\"downpour\")) {\n      distanceShift = -1;\n      awarenessModifier = 20;\n      effects.push(\"Distance one step closer\");\n      effects.push(\"Awareness Difficulty +20\");\n    } else if (\n      weather.includes(\"rain\") ||\n      weather.includes(\"snow\")\n    ) {\n      distanceShift = -1;\n      awarenessModifier = 10;\n      effects.push(\"Distance one step closer\");\n      effects.push(\"Awareness Difficulty +10\");\n    }\n\n    return {\n      distanceShift,\n      awarenessModifier,\n      effects\n    };\n  }\n\n  function parseEncounter(text) {\n    const plain = stripHtml(text);\n    const match = plain.match(/\\(([^()]*)\\)\\s*$/);\n\n    if (!match) {\n      return null;\n    }\n\n    const parts = match[1]\n      .split(\",\")\n      .map(part => part.trim());\n\n    if (parts.length !== 3) {\n      return null;\n    }\n\n    const [size, motivation, visibility] = parts;\n\n    if (![\"Small\", \"Medium\", \"Large\"].includes(size)) {\n      return null;\n    }\n\n    if (![\"Friendly\", \"Indifferent\", \"Hostile\"].includes(motivation)) {\n      return null;\n    }\n\n    if (![\"Stealthy\", \"Normal\", \"Obvious\"].includes(visibility)) {\n      return null;\n    }\n\n    return {\n      name: plain.slice(0, match.index).trim(),\n      size,\n      motivation,\n      visibility\n    };\n  }\n\n  function findDistanceIndex(text) {\n    const wanted = normalise(text);\n\n    return DISTANCE_STEPS.findIndex(\n      step => normalise(step) === wanted\n    );\n  }\n\n  async function drawAwareness(modifier) {\n    const raw = await d100();\n\n    const adjusted = Math.max(\n      1,\n      Math.min(100, raw + modifier)\n    );\n\n    const table = getTable(AWARENESS_TABLE);\n\n    if (table) {\n      const fixedRoll = await new Roll(\n        String(adjusted)\n      ).evaluate({\n        async: true\n      });\n\n      const draw = await table.draw({\n        roll: fixedRoll,\n        displayChat: false\n      });\n\n      const text = await tableResultText(\n        firstDrawResult(draw) ?? draw\n      );\n\n      if (text) {\n        return stripHtml(text);\n      }\n    }\n\n    if (adjusted <= 20) {\n      return \"Encounter Surprised\";\n    }\n\n    if (adjusted <= 40) {\n      return \"Encounter Unaware\";\n    }\n\n    if (adjusted <= 60) {\n      return \"Both Aware\";\n    }\n\n    if (adjusted <= 80) {\n      return \"Party Unaware\";\n    }\n\n    return \"Party Surprised\";\n  }\n\n  function shiftDistance(baseDistance, encounter, weather) {\n    let index = findDistanceIndex(baseDistance);\n\n    if (index < 0) {\n      index = 1;\n    }\n\n    if (\n      encounter.size === \"Small\" ||\n      encounter.visibility === \"Stealthy\"\n    ) {\n      index--;\n    }\n\n    if (\n      encounter.size === \"Large\" ||\n      encounter.visibility === \"Obvious\"\n    ) {\n      index++;\n    }\n\n    index += weather.distanceShift;\n\n    index = Math.max(\n      0,\n      Math.min(DISTANCE_STEPS.length - 1, index)\n    );\n\n    return DISTANCE_STEPS[index];\n  }\n\n  async function wildernessEncounter(\n    environment,\n    period,\n    weather\n  ) {\n    const chance =\n      ENCOUNTER_CHANCES[environment]?.[period] ?? 30;\n\n    const mainRoll = await d100();\n\n    const extraRoll =\n      mainRoll > chance\n        ? await d100()\n        : 0;\n\n    const encounterHappens =\n      mainRoll <= chance ||\n      extraRoll <= EXTRA_ENCOUNTER_CHANCE;\n\n    if (!encounterHappens) {\n      return `<b>${period}</b><br>No Encounter`;\n    }\n\n    const tablePeriod =\n      period === \"Night\"\n        ? \"Night\"\n        : \"Day\";\n\n    const encounterTable =\n      `${environment} ${tablePeriod}`;\n\n    const encounterText =\n      await drawTableResult(encounterTable);\n\n    const encounter =\n      parseEncounter(encounterText);\n\n    if (!encounter) {\n      return [\n        `<b>${period} — Encounter</b>`,\n        encounterText\n      ].join(\"<br>\");\n    }\n\n    const baseDistance =\n      await drawTableResult(DISTANCE_TABLE);\n\n    const distance =\n      shiftDistance(\n        baseDistance,\n        encounter,\n        weather\n      );\n\n    let awarenessModifier =\n      weather.awarenessModifier;\n\n    if (encounter.size === \"Small\") {\n      awarenessModifier += 10;\n    }\n\n    if (encounter.size === \"Large\") {\n      awarenessModifier -= 10;\n    }\n\n    if (encounter.visibility === \"Stealthy\") {\n      awarenessModifier += 20;\n    }\n\n    if (encounter.visibility === \"Obvious\") {\n      awarenessModifier -= 20;\n    }\n\n    const awareness =\n      await drawAwareness(awarenessModifier);\n\n    const reactionAwareness = new Set([\n      \"both aware\",\n      \"party unaware\",\n      \"party surprised\"\n    ]);\n\n    let reaction =\n      \"No reaction roll — party acts first\";\n\n    if (\n      reactionAwareness.has(\n        normalise(awareness)\n      )\n    ) {\n      reaction =\n        stripHtml(\n          await drawTableResult(\n            `${encounter.motivation} Reaction`\n          )\n        );\n    }\n\n    return [\n      `<b>${period} — Encounter</b>`,\n      `<b>Encounter:</b> ${encounter.name}`,\n      `<b>Distance:</b> ${distance}`,\n      `<b>Awareness:</b> ${awareness}`,\n      `<b>Reaction:</b> ${reaction}`\n    ].join(\"<br>\");\n  }\n\n  async function settlementEvent(size) {\n    const tableName = SETTLEMENT_TABLES[size];\n\n    const event =\n      await drawTableResult(tableName);\n\n    return [\n      `<b>Night — ${escapeHtml(tableName)}</b>`,\n      event\n    ].join(\"<br>\");\n  }\n\n  function fieldValue(html, selector) {\n    const element =\n      html?.querySelector?.(selector) ??\n      html?.find?.(selector)?.[0];\n\n    return element?.value ?? \"\";\n  }\n\n  function fieldChecked(html, selector) {\n    const element =\n      html?.querySelector?.(selector) ??\n      html?.find?.(selector)?.[0];\n\n    return Boolean(element?.checked);\n  }\n\n  function askForOptions() {\n    const environments = [\n      \"Road\",\n      \"River\",\n      \"Forest\",\n      \"Marsh\",\n      \"Hills\",\n      \"Mountains\"\n    ];\n\n    const seasons = [\n      \"Spring\",\n      \"Summer\",\n      \"Autumn\",\n      \"Winter\"\n    ];\n\n    const environmentOptions =\n      environments\n        .map(value =>\n          `<option value=\"${value}\">${value}</option>`\n        )\n        .join(\"\");\n\n    const seasonOptions =\n      seasons\n        .map(value =>\n          `<option value=\"${value}\">${value}</option>`\n        )\n        .join(\"\");\n\n    const visibilityControl =\n      game.user.isGM\n        ? `\n          <div class=\"form-group\">\n            <label>Show results to players</label>\n            <input\n              type=\"checkbox\"\n              name=\"showToPlayers\"\n              checked\n            >\n          </div>\n        `\n        : \"\";\n\n    const content = `\n      <form>\n        <div class=\"form-group\">\n          <label>Environment</label>\n          <select name=\"environment\">\n            ${environmentOptions}\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Season</label>\n          <select name=\"season\">\n            ${seasonOptions}\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Wilderness travel days</label>\n          <input\n            type=\"number\"\n            name=\"days\"\n            min=\"1\"\n            max=\"30\"\n            value=\"3\"\n          >\n        </div>\n\n        <hr>\n\n        <div class=\"form-group\">\n          <label>Final night</label>\n          <select name=\"finalNight\">\n            <option value=\"camp\">\n              Wilderness camp — use the normal night roll\n            </option>\n            <option value=\"settlement\">\n              Stay at a settlement — use a settlement table\n            </option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Settlement size</label>\n          <select name=\"settlementSize\">\n            <option value=\"Small\">\n              Small — coaching inn / farm\n            </option>\n            <option value=\"Medium\">\n              Medium — small or medium settlement\n            </option>\n            <option value=\"Large\">\n              Large — town / small city\n            </option>\n          </select>\n        </div>\n\n        ${visibilityControl}\n      </form>\n    `;\n\n    return new Promise(resolve => {\n      new Dialog({\n        title: \"Generate Road Journey Leg\",\n        content,\n\n        buttons: {\n          generate: {\n            label: \"Generate\",\n\n            callback: html => resolve({\n              environment:\n                fieldValue(\n                  html,\n                  '[name=\"environment\"]'\n                ),\n\n              season:\n                fieldValue(\n                  html,\n                  '[name=\"season\"]'\n                ),\n\n              days:\n                Math.max(\n                  1,\n                  Math.min(\n                    30,\n                    Number(\n                      fieldValue(\n                        html,\n                        '[name=\"days\"]'\n                      )\n                    ) || 1\n                  )\n                ),\n\n              finalNight:\n                fieldValue(\n                  html,\n                  '[name=\"finalNight\"]'\n                ) || \"camp\",\n\n              settlementSize:\n                fieldValue(\n                  html,\n                  '[name=\"settlementSize\"]'\n                ) || \"Small\",\n\n              showToPlayers:\n                game.user.isGM\n                  ? fieldChecked(\n                      html,\n                      '[name=\"showToPlayers\"]'\n                    )\n                  : true\n            })\n          },\n\n          cancel: {\n            label: \"Cancel\",\n            callback: () => resolve(null)\n          }\n        },\n\n        default: \"generate\",\n        close: () => resolve(null)\n      }).render(true);\n    });\n  }\n\n  async function generateJourney(options) {\n    const {\n      environment,\n      season,\n      days,\n      finalNight,\n      settlementSize\n    } = options;\n\n    const lines = [\n      `<h2>ROAD JOURNEY LEG</h2>`,\n\n      `<p>\n        <b>Environment:</b> ${escapeHtml(environment)}<br>\n        <b>Season:</b> ${escapeHtml(season)}<br>\n        <b>Days:</b> ${days}\n      </p>`\n    ];\n\n    for (let day = 1; day <= days; day++) {\n      const weatherText =\n        await drawTableResult(\n          `Weather Table - ${season}`\n        );\n\n      const weather =\n        weatherEffects(weatherText);\n\n      lines.push(`<h3>DAY ${day}</h3>`);\n\n      lines.push(\n        `<b>Weather:</b> ${weatherText}`\n      );\n\n      if (weather.effects.length) {\n        lines.push(\n          `<br><b>Weather Effects:</b> ${\n            weather.effects.join(\", \")\n          }`\n        );\n      }\n\n      lines.push(\n        `<p>${\n          await wildernessEncounter(\n            environment,\n            \"Morning\",\n            weather\n          )\n        }</p>`\n      );\n\n      lines.push(\n        `<p>${\n          await wildernessEncounter(\n            environment,\n            \"Afternoon\",\n            weather\n          )\n        }</p>`\n      );\n\n      if (\n        day === days &&\n        finalNight === \"settlement\"\n      ) {\n        lines.push(\n          `<p>${\n            await settlementEvent(\n              settlementSize\n            )\n          }</p>`\n        );\n      } else {\n        lines.push(\n          `<p>${\n            await wildernessEncounter(\n              environment,\n              \"Night\",\n              weather\n            )\n          }</p>`\n        );\n      }\n    }\n\n    return lines.join(\"\\n\");\n  }\n\n  async function postJourney(\n    content,\n    showToPlayers\n  ) {\n    if (!game.user.isGM || showToPlayers) {\n      await ChatMessage.create({\n        speaker: ChatMessage.getSpeaker(),\n        content\n      });\n\n      return;\n    }\n\n    const revealId =\n      foundry.utils.randomID();\n\n    const privateContent = `\n      ${content}\n\n      <hr>\n\n      <p>\n        <em>\n          This journey is currently visible only to the GM.\n        </em>\n      </p>\n\n      <button\n        type=\"button\"\n        class=\"reveal-road-journey\"\n        data-reveal-id=\"${revealId}\"\n      >\n        Reveal to Players\n      </button>\n    `;\n\n    const hookId =\n      Hooks.on(\n        \"renderChatMessage\",\n        (message, html) => {\n          const root =\n            html?.querySelector\n              ? html\n              : html?.[0];\n\n          const button =\n            root?.querySelector?.(\n              `[data-reveal-id=\"${revealId}\"]`\n            );\n\n          if (!button) {\n            return;\n          }\n\n          button.addEventListener(\n            \"click\",\n            async () => {\n              button.disabled = true;\n\n              await ChatMessage.create({\n                speaker: ChatMessage.getSpeaker(),\n                content\n              });\n\n              await message.delete();\n\n              Hooks.off(\n                \"renderChatMessage\",\n                hookId\n              );\n            },\n            { once: true }\n          );\n        }\n      );\n\n    const gmIds =\n      game.users\n        .filter(user => user.isGM)\n        .map(user => user.id);\n\n    await ChatMessage.create({\n      speaker: ChatMessage.getSpeaker(),\n      content: privateContent,\n      whisper: gmIds\n    });\n  }\n\n  try {\n    const options =\n      await askForOptions();\n\n    if (!options) {\n      return;\n    }\n\n    const content =\n      await generateJourney(options);\n\n    await postJourney(\n      content,\n      options.showToPlayers\n    );\n  } catch (error) {\n    console.error(\n      \"ROAD JOURNEY LEG macro error\",\n      error\n    );\n\n    ui.notifications.error(\n      error.message ||\n      \"The road journey could not be generated.\"\n    );\n  }\n})();","sort":100000,"ownership":{"default":3,"hA3srlFoDba8ZYIJ":3,"ahZbkFJOFQn1ejMx":3,"w6klZZXPtwtKcZSw":3,"IorPi93JkjcNWugn":3,"uQ0qFQJ97N6EXg39":3,"2V5lXSJwJUSH8srY":3},"_id":"Jh54PqHMnXuC848E"}
